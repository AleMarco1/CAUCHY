# ============================================================
# CAUCHY - .gitattributes
# I file di risultato portano hash di integrita' calcolati sui
# BYTE: una conversione di fine riga da parte di git li corrompe
# senza che nulla se ne accorga. Gia' successo con quelli del
# Paper 1: da li' viene la regola 'results/** -text'.
# ============================================================

# Nessuna normalizzazione su NULLA dentro results/ e MANIFESTS/.
results/**      -text
manifests/**    -text

# I formati append-only, ovunque si trovino.
*.jsonl         -text
*.json          -text

# Anche i manifest e i digest sono byte-sensibili.
*.sha256        -text
*.manifest      -text

# Binari, se mai qualcuno li forzasse in git con -f.
*.npy   binary
*.npz   binary
*.pkl   binary
*.fits  binary
*.pdf   binary
*.png   binary
*.zip   binary
*.docx  binary

# Sorgenti e documenti: normalizzazione normale.
*.py    text
*.md    text
*.txt   text
*.tex   text
*.bib   text
*.yml   text
*.cff   text
*.ps1   text eol=crlf
*.sh    text eol=lf
