# ============================================================
# CAUCHY - .gitignore
# Principio: git tiene testo piccolo e diffabile. Tutto il resto
# e' livello B (Zenodo), C (rigenerabile) o D (dato di terzi).
# ============================================================

# --- D: dato di terzi. Si cita col proprio DOI, non si rideposita.
data/raw/

# --- C: rigenerabile da noi.
data/processed/
results/**/curves_*/
results/phase1_persistence_diagrams/
results/phase2_tau_fields/
results/phase_r51_cache*/
results/phase5_hod_b3_fields/
results/phase6_mock_chains*/

# --- B: binari congelati. Vanno su Zenodo, non in git.
*.npy
*.npz
*.pkl
*.h5
*.hdf5
*.fits
*.fits.gz

# --- PDF di terzi: diritti altrui, 131 MiB.
literature/

# --- artefatti rigenerabili dello stesso repo.
results/paper2/inventory.json
inventory_report.json
inventory.csv

# --- copie di sicurezza e temporanei
*.bak
*.bak_*
*.tmp
*~

# --- ambiente
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.mypy_cache/

# ============================================================
# ECCEZIONI: i file del livello B che DEVONO restare in git
# perche' sono piccoli e sono ingressi di cancello.
# (nessuna, per ora: maschere e scale nulle vanno su Zenodo.
#  Se un giorno servisse, si aggiunge qui con '!')
# ============================================================

results/paper2/remote_audit.json

# artefatti e scarti
folders.txt
pipeline_code_bundle.md
pipeline_code_report.json
test.py

# confidenziale: manoscritti in revisione, referee, prompt
prompts/
papers/m26/
papers/paper1/MNRAS/
papers/paper2/MNRAS/
paper/

PURGE.md
purge_paths.txt
